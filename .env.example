# Configuración básica de la aplicación
APP_NAME=OpenIndoor
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=openindoor
DB_USERNAME=opencogollos_dev
DB_PASSWORD=devpassword

BROWSER_HEADLESS=true
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_EXAMPLE_DATA=false

DOCKER_IMAGE=openindoor:latest

# --- Bot del cultivador (tenant) ---
# Token del bot creado con @BotFather: es el bot que usan los cultivadores.
TELEGRAM_BOT_TOKEN=
# Secret token que Telegram manda en el header X-Telegram-Bot-Api-Secret-Token.
# Obligatorio: sin esto el webhook del cultivador rechaza todo (503, fail closed).
# Generarlo con algo aleatorio, p.ej.: openssl rand -hex 32
TELEGRAM_SECRET_TOKEN=
# URL del webhook (default: APP_URL/api/telegram/webhook)
TELEGRAM_WEBHOOK_URL=

# --- Bot de administración (superadmin) ---
# Token del bot creado con @BotFather para administrar la plataforma.
TELEGRAM_ADMIN_BOT_TOKEN=
# Secret token que Telegram manda en el header X-Telegram-Bot-Api-Secret-Token.
# Obligatorio: sin esto el webhook admin rechaza todo (503, fail closed).
TELEGRAM_ADMIN_SECRET_TOKEN=
# URL del webhook (default: APP_URL/api/telegram/admin/webhook)
TELEGRAM_ADMIN_WEBHOOK_URL=
# Ids numéricos de Telegram autorizados (separados por coma). Solo superadmin.
TELEGRAM_ADMIN_ALLOWED_USER_IDS=
# Resumen proactivo automático (novedades por Telegram). true/false
TELEGRAM_ADMIN_DIGEST_ENABLED=true