# Configuración de desarrollo local
APP_NAME="OpenIndoor (Local)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Base de datos local (usar Docker o localhost)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=openindoor_dev
DB_USERNAME=root
DB_PASSWORD=

# Configuración simplificada para desarrollo
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
CACHE_DRIVER=file

# Email local (Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025

# Variables específicas para desarrollo
SEED_EXAMPLE_DATA=true