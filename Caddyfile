plataforma.cannabica.ar {
    root * /var/www/html/public
    encode gzip

    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }


    @blocked_paths {
        path /actuator/* /server/* /config/*
    }
    @blocked_vendor {
        path_regexp \/(vendor|storage|uploads)\/.*\.php$
    }

    # Allow ACME challenges
    handle_path /.well-known/acme-challenge/* {
        file_server
    }

    # Block hidden files
    @hidden {
        path */.*
    }
    respond @hidden 404
    respond @blocked_paths 404
    respond @blocked_vendor 404

    @tenant path_regexp tenant ^/tenant/actions/\d+/([^/]+)/storage/(.*)$
    rewrite @tenant /storage/{re.tenant.2}

    # Serve static assets (CSS, JS, fonts) - the symlink to storage is removed,
    # so /storage/* requests will NOT match any file and fall through to PHP
    file_server
    php_fastcgi php:9000
}

status.cannabica.ar {
    reverse_proxy uptime-kuma:3001
}
