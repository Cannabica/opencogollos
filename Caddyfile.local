:80, :443 {
    tls internal
    root * /var/www/html/public
    encode gzip

    @blocked_paths {
        path /actuator/* /server/* /config/*
    }
    @blocked_vendor {
        path_regexp \/(vendor|storage|uploads)\/.*\.php$
    }

    @hidden {
        path */.*
    }
    respond @hidden 404
    respond @blocked_paths 404
    respond @blocked_vendor 404

    @tenant path_regexp tenant ^/tenant/actions/\d+/([^/]+)/storage/(.*)$
    rewrite @tenant /storage/{re.tenant.2}

    file_server
    php_fastcgi php:9000
}
