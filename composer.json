{
  "name": "cannabica/opencogollos",
  "type": "project",
  "version": "0.19.4",
  "description": "Registro, trazabilidad y compliance de cultivos (indoor y exterior): plantas, acciones de cuidado, tareas y bot de Telegram.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "AGPL-3.0-only",
  "require": {
    "php": "^8.3",
    "codeat3/blade-phosphor-icons": "^2.2",
    "filament/filament": "^3.2",
    "filament/notifications": "^3.3",
    "flowframe/laravel-trend": "^0.4.0",
    "guzzlehttp/guzzle": "^7.2",
    "irazasyed/telegram-bot-sdk": "^3.15",
    "laravel/framework": "^10.10",
    "laravel/sanctum": "^3.3",
    "laravel/tinker": "^2.8",
    "leandrocfe/filament-apex-charts": "^3.1",
    "rupadana/filament-api-service": "^3.4.10",
    "symfony/polyfill-intl-icu": "^1.32",
    "tymon/jwt-auth": "^2.2",
    "fakerphp/faker": "^1.23"
  },
  "require-dev": {
    "larastan/larastan": "^2.11",
    "laravel/breeze": "^1.29",
    "laravel/pint": "^1.0",
    "laravel/sail": "^1.18",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^7.0",
    "phpunit/phpunit": "^10.1",
    "spatie/laravel-ignition": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=1G",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
