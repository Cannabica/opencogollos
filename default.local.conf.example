# Configuración de Nginx para desarrollo local
server {
    listen 80;
    server_name localhost;
    root /var/www/html/public;
    index index.php;

    # Configuración básica para Laravel
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Configuración PHP para desarrollo
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        
        # Configuraciones opcionales para desarrollo
        fastcgi_param APP_ENV local;
        fastcgi_param APP_DEBUG true;
    }

    # Bloquear acceso a archivos ocultos
    location ~ /\.(?!well-known).* {
        deny all;
    }

    # Logs (opcional para desarrollo)
    error_log  /var/log/nginx/error.log debug;
    access_log /var/log/nginx/access.log;
}

