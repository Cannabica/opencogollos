includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - tests

    # Laravel: los modelos/middleware resuelven tipos por reflection y los helpers devuelven `mixed`.
    treatPhpDocTypesAsCertain: false

    excludePaths:
        analyse:
            - bootstrap/cache/*
            # -----------------------------------------------------------------------------------
            # EXCLUSIONES A PROPOSITO — NO son ruido: son BUGS REALES que PHPStan encontró y
            # que NO se pueden ni arreglar dentro del alcance de la tarjeta, ni baselinear, ni
            # ignorar ("Error message ... cannot be ignored, use excludePaths instead").
            # Es una DEUDA CON TICKET: cuando se arreglen, se sacan estas lineas y el analisis
            # vuelve a cubrir los archivos. Detalle y evidencia: board/epicas/
            # 2026-09-14-ws2-kit-calidad.md §3.1 y §4.
            #
            # T2.6 (2026-09-19): se sacaron las 2 exclusiones de ListSeeds/ViewIndoor y
            # HandlesActionTypes porque el codigo v2 que las motivaba YA SE BORRO
            # (ver board/epicas/2026-09-18-t26-limpieza-estructural.md).
            #
            # QUEDA 1 SOLA (F1, esperando decision de producto D1): `class TelegramBotManager
            # extends final class BotsManager` (el SDK v3.16 lo declara final). `class_exists()`
            # lo reproduce: "cannot extend final class". Hoy no explota solo porque el container
            # resuelve `telegram` al BotsManager del SDK y los bindings de TelegramServiceProvider
            # quedan SOMBREADOS (codigo muerto). Si cambia el orden de providers, la app muere
            # al bootear. Decision: refactor por composicion (B) o borrar la clase + sus
            # bindings muertos (A).
            - app/Services/TelegramBotManager.php
            # -----------------------------------------------------------------------------------
